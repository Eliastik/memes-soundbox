{
  "name": "memes-soundbox",
  "version": "1.1.7",
  "private": false,
  "scripts": {
    "dev": "npm run copy-worklets-worklets && next dev --webpack",
    "build": "next build --webpack",
    "start": "next start --webpack",
    "lint": "next lint",
    "test": "npx playwright test",
    "prebuild": "npm run copy-worklets-worklets",
    "copy-worklets-worklets": "mkdir -p public/worklets public/workers && cp node_modules/@eliastik/simple-sound-studio-lib/dist/worklets/*.js public/worklets/ && cp node_modules/@eliastik/simple-sound-studio-lib/dist/workers/*.js public/workers/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eliastik/memes-soundbox.git"
  },
  "dependencies": {
    "@eliastik/simple-sound-studio-components": "^2.3.2",
    "@eliastik/simple-sound-studio-lib": "^2.3.2",
    "i18next": "^27.0.1",
    "lodash": "^4.18.1",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.0",
    "semver": "^7.8.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/audioworklet": "^0.0.75",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.66.1",
    "@typescript-eslint/parser": "^8.67.0",
    "daisyui": "^5.7.50",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "eslint-plugin-react": "^7.37.5",
    "glob": "^14.0.4",
    "next-pwa": "^5.6.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "serialize-javascript": "7.1.0"
  }
}
